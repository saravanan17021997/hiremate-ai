{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "ELECTRON_SKIP_BINARY_DOWNLOAD=1 npm ci",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist-web",
  "functions": {
    "api/ask.ts": { "maxDuration": 60 },
    "api/extract.ts": { "maxDuration": 60 },
    "api/transcribe.ts": { "maxDuration": 30 },
    "api/me.ts": { "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), microphone=(self), display-capture=(self)" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ]
}
