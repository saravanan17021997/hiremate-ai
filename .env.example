# ---------- Desktop app (optional cloud sync) ----------
# Supabase > Project Settings > API: Project URL, and the "anon public" key. PUBLIC values only.
# Never put the service_role / secret key here: the app refuses to start sync with one.
MAIN_VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
MAIN_VITE_SUPABASE_ANON_KEY=eyJ...

# ---------- Web version (Vercel). Set these in Vercel > Project > Settings > Environment Variables. ----------
# Public (built into the website): same two values as above.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# Server only (never sent to browsers):
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=eyJ...
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-20b
# Who may sign in (comma separated). Nobody can use the site until you add emails here.
ALLOWED_EMAILS=you@example.com, friend@example.com
